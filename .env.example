# ---------------------------------------------------------------
# Tandem — environment variables. ALL OPTIONAL.
# With none set, the app runs in Demo mode (in-browser backend).
# ---------------------------------------------------------------

# --- Frontend (bundled into the browser: never put secrets here) ---
# "local" = deterministic in-browser intelligence (default)
# "meta"  = brief interpretation, outreach and strategist call /api/meta/* (server-side)
VITE_AI_PROVIDER=local

# --- Server only (Vercel → Project → Settings → Environment Variables) ---
# Meta Model API (https://dev.meta.ai). Read only by /api/meta/*.ts.
META_MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_API_BASE_URL=https://api.meta.ai/v1

# --- Supabase (production backend, see docs/SUPABASE.md) ---
# The anon key is public by design; security comes from Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# NEVER expose the service-role key to the browser. Server-side jobs only.
SUPABASE_SERVICE_ROLE_KEY=
